# Supabase project settings, API page.
# The legacy "anon" key also works in the publishable slot.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, server only. Needed once an integration stores a token (Canvas, Strava, Google).
# 32 random bytes, base64:  openssl rand -base64 32
INTEGRATIONS_KEY=

# Optional, server only. The app's AI (food photos, weekly debrief, reading tests) uses Gemini first.
# Google AI Studio, Get API key. A Google AI Pro subscription does not include API usage.
GEMINI_API_KEY=
# Optional: override the first Gemini model tried.
GEMINI_MODEL=

# Optional, server only. Backup AI when Gemini is not set or is down.
ANTHROPIC_API_KEY=

# Optional, server only. Lyfta workouts: Lyfta, Settings, API, generate a key.
LYFTA_API_KEY=

# Server only. The app has no sign-in screen: the server signs in this Supabase user automatically.
# Create the user in Supabase (Authentication, Users, Add user, Auto confirm), then set both here and in Vercel.
FORGE_OWNER_EMAIL=
FORGE_OWNER_PASSWORD=
