# Supabase project settings, API page.
# The legacy "anon" key also works in the publishable slot.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, server only. Needed once an integration stores a token (Canvas, Lifta, Google).
# 32 random bytes, base64:  openssl rand -base64 32
INTEGRATIONS_KEY=

# Optional, server only. Enables food photo analysis, the weekly debrief, and generated reading tests.
ANTHROPIC_API_KEY=
